{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xPST",
  "version": "0.1.0",
  "identifier": "com.xpst.poc",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "xPST",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8080 http://localhost:8080 ws://127.0.0.1:8080; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "xPST Tauri shell POC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://tysais.github.io/xPST/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzRjI5MEIxMzE2NjI2RTIKUldUaUptWXhzWkR5RXdZdUVuaU9MdjFEM1NSREt5eVVBSEVQRXUzb3gwd2t4MkRZczRXdUFyZ3QK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["xpst"]
      }
    }
  }
}
