ct before the album call; over 10 items or under 2 is refused, never truncated"}, {"content_type": "text", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}, {"content_type": "thread", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}], "note": ""}, "tiktok": {"platform": "tiktok", "display_name": "TikTok", "role": "video_destination", "publishing": true, "declared": ["video"], "declared_labels": ["video"], "implemented": ["video"], "declared_but_unimplemented": [], "implemented_but_undeclared": [], "media_transport": "local_upload", "accepts_local_media": true, "media_transport_requirement": "", "media_transport_error_code": null, "video_envelope": {"platform": "tiktok", "display_name": "TikTok", "max_duration_seconds": 600, "shorts_max_duration_seconds": null, "max_bytes": 1073741824, "containers": [".mp4", ".mov"], "video_codec": "h264", "aspect_min": null, "aspect_max": null, "shorts_max_aspect_ratio": null, "modes": ["shorts"], "long_form": false, "source": "TikTok Content Posting API: video up to 10 minutes, 1 GB", "note": ""}, "integration": "ready", "content": [{"content_type": "video", "declared": true, "implemented": true, "supported": true, "status": "supported", "note": ""}, {"content_type": "image", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}, {"content_type": "carousel", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": "no carousel path: a carousel request is refused by name, and nothing is stitched into a video"}, {"content_type": "text", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}, {"content_type": "thread", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}], "note": "video is implemented on two routes: xPST's own Content Posting API route is blocked by TikTok app review, and the rented aggregator route (accounts.tiktok.provider: zernio) publishes publicly through the vendor's audited app; there is no carousel path on either route"}, "threads": {"platform": "threads", "display_name": "Threads", "role": "video_destination", "publishing": true, "declared": ["text", "video"], "declared_labels": ["video", "text"], "implemented": ["text", "video"], "declared_but_unimplemented": [], "implemented_but_undeclared": [], "media_transport": "public_url", "accepts_local_media": false, "media_transport_requirement": "Threads has no upload endpoint: its API fetches your media from a public server, and xPST is a local tool with no server to host a file for it. A local file cannot be published to Threads, and xPST cannot deliver a media URL either yet — post this content from the Threads app instead.", "media_transport_error_code": "THREADS_NEEDS_URL", "video_envelope": {"platform": "threads", "display_name": "Threads", "max_duration_seconds": 300, "shorts_max_duration_seconds": null, "max_bytes": 1073741824, "containers": [".mp4", ".mov"], "video_codec": "h264", "aspect_min": null, "aspect_max": null, "shorts_max_aspect_ratio": null, "modes": ["shorts"], "long_form": false, "source": "Threads API: video up to 5 minutes (the container fetches it from a public URL)", "note": ""}, "integration": "ready", "content": [{"content_type": "video", "declared": true, "implemented": true, "supported": true, "status": "supported", "note": "published only from media that is already hosted at a public URL: the Threads API retrieves the URL itself and has no binary upload, so a local file is refused before any network call (see media_transport). xPST cannot deliver a media URL to any uploader yet either, so no media publishing path reaches Threads today"}, {"content_type": "image", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}, {"content_type": "carousel", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": "no carousel path: a carousel request is refused by name, and nothing is stitched into a video"}, {"content_type": "text", "declared": true, "implemented": true, "supported": true, "status": "supported", "note": "one text post (500 characters max) via the TEXT container, no media needed"}, {"content_type": "thread", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}], "note": "Threads is a URL-fetch destination for media: it publishes what it can download from a public URL, never a local file — and xPST cannot hand it a URL yet, so media publishing is refused today. Text posts need no URL and are published verbatim through a media_type TEXT container."}, "facebook": {"platform": "facebook", "display_name": "Facebook Page", "role": "video_destination", "publishing": true, "declared": ["video"], "declared_labels": ["video"], "implemented": ["video"], "declared_but_unimplemented": [], "implemented_but_undeclared": [], "media_transport": "local_upload", "accepts_local_media": true, "media_transport_requirement": "", "media_transport_error_code": null, "video_envelope": {"platform": "facebook", "display_name": "Facebook Page", "max_duration_seconds": 14400, "shorts_max_duration_seconds": null, "max_bytes": 10737418240, "containers": [".mp4", ".mov"], "video_codec": "h264", "aspect_min": null, "aspect_max": null, "shorts_max_aspect_ratio": null, "modes": ["shorts"], "long_form": false, "source": "Graph API /{page-id}/videos: up to 4 hours, 10 GB", "note": ""}, "integration": "ready", "content": [{"content_type": "video", "declared": true, "implemented": true, "supported": true, "status": "supported", "note": ""}, {"content_type": "image", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}, {"content_type": "carousel", "declared": false, "implemented": false, "supported": false, "status": "undeclared", "note": ""}, {"content_type": "text", "