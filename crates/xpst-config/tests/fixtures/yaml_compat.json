- id: strings_needing_quotes
  yaml: "version: 4\ntext:\n  colon: 'a: b'\n  hash: '#x'\n  empty: ''\n  tilde_home:\
    \ ~/x/y\n  truthy_string: 'true'\n  null_string: 'null'\n  digits: '123'\n  spaced:\
    \ '  padded  '\n  unicode: \"café \U0001F680\"\n"
  outcome: ok
  json_raw: '{"version": 4, "text": {"colon": "a: b", "hash": "#x", "empty": "", "tilde_home":
    "~/x/y", "truthy_string": "true", "null_string": "null", "digits": "123", "spaced":
