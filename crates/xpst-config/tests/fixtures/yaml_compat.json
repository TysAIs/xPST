- id: block_and_multiline
  yaml: "version: 4\nmonitoring:\n  notes: |\n    line one\n    line two\n  folded:\
    \ >\n    wrapped text\n    continues here\n"
  outcome: ok
  json_raw: '{"version": 4, "monitoring": {"notes": "line one\nline two\n", "folded":
    "wrapped text continues here\n"}}'
  json_masked: '{"version": 4, "monitoring": {"notes": "line one\nline two\n", "folded":
    "wrapped text continues here\n"}}'
- id: nulls_and_empty
