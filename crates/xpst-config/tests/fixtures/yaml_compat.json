- id: realistic_v4
  yaml: "version: 4\naccounts:\n  youtube:\n    enabled: true\n    token_file: /home/someone/.xpst/credentials/youtube_token.json\n\
    \    channel_id: UC0000000000000000000000\n  x:\n    enabled: false\n    cookies_file:\
    \ ''\n    auth_mode: cookies\n    username: someone\n    api_key: sk-test-000\n\
    \  bluesky:\n    enabled: true\n    identifier: someone.bsky.social\n    service:\
    \ https://bsky.social\n    app_password: abcd-efgh-ijkl-mnop\n  mastodon:\n  \
    \  enabled: false\n    instance: https://mastodon.example\n    access_token: tok_123\n\
    video:\n  download_dir: /tmp/xpst-downloads\n  max_duration: 180\nmonitoring:\n\
    \  log_file: /tmp/xpst-logs/xpst.log\n  level: INFO\nschedule:\n  times: [\"09:00\"\
    , \"18:00\"]\n  timezone: America/Denver\n  max_per_day: 3\nnotifications:\n \
    \ webhook_url: https://hooks.example/T000/B000/XXXX\n  enabled: false\n"
  outcome: ok
  json_raw: '{"version": 4, "accounts": {"youtube": {"enabled": true, "token_file":
    "/home/someone/.xpst/credentials/youtube_token.json", "channel_id": "UC0000000000000000000000"},
    "x": {"enabled": false, "cookies_file": "", "auth_mode": "cookies", "username":
    "someone", "api_key": "sk-test-000"}, "bluesky": {"enabled": true, "identifier":
    "someone.bsky.social", "service": "https://bsky.social", "app_password": "abcd-efgh-ijkl-mnop"},
    "mastodon": {"enabled": false, "instance": "https://mastodon.example", "access_token":
    "tok_123"}}, "video": {"download_dir": "/tmp/xpst-downloads", "max_duration":
    180}, "monitoring": {"log_file": "/tmp/xpst-logs/xpst.log", "level": "INFO"},
    "schedule": {"times": ["09:00", "18:00"], "timezone": "America/Denver", "max_per_day":
    3}, "notifications": {"webhook_url": "https://hooks.example/T000/B000/XXXX", "enabled":
    false}}'
  json_masked: '{"version": 4, "accounts": {"youtube": {"enabled": true, "token_file":
    "***", "channel_id": "UC0000000000000000000000"}, "x": {"enabled": false, "cookies_file":
    "", "auth_mode": "***", "username": "someone", "api_key": "***"}, "bluesky": {"enabled":
    true, "identifier": "someone.bsky.social", "service": "https://bsky.social", "app_password":
    "***"}, "mastodon": {"enabled": false, "instance": "https://mastodon.example",
    "access_token": "***"}}, "video": {"download_dir": "/tmp/xpst-downloads", "max_duration":
    180}, "monitoring": {"log_file": "/tmp/xpst-logs/xpst.log", "level": "INFO"},
    "schedule": {"times": ["09:00", "18:00"], "timezone": "America/Denver", "max_per_day":
    3}, "notifications": {"webhook_url": "***", "enabled": false}}'
- id: yaml11_lookalike_scalars
  yaml: "version: 4\noptions:\n  flag_on: on\n  flag_yes: yes\n  flag_off: off\n \
    \ flag_no: no\n  single_y: y\n  single_n: n\n  truthy: true\n  falsy: false\n"
  outcome: ok
  json_raw: '{"version": 4, "options": {"flag_on": true, "flag_yes": true, "flag_off":
    false, "flag_no": false, "single_y": "y", "single_n": "n", "truthy": true, "falsy":
    false}}'
  json_masked: '{"version": 4, "options": {"flag_on": true, "flag_yes": true, "flag_off":
    false, "flag_no": false, "single_y": "y", "single_n": "n", "truthy": true, "falsy":
    false}}'
- id: numeric_strings
  yaml: "version: 4\nvalues:\n  phone: '0123456789'\n  leading_zero: 007\n  underscored:\
    \ 1_000\n  quoted_int: '42'\n  plain_int: 42\n  negative: -17\n  hex: 0x1f\n \
    \ octal: 0o17\n  float: 1.10\n  expo: 1e3\n  version_string: 4.1.0\n"
  outcome: ok
  json_raw: '{"version": 4, "values": {"phone": "0123456789", "leading_zero": 7, "underscored":
    1000, "quoted_int": "42", "plain_int": 42, "negative": -17, "hex": 31, "octal":
    "0o17", "float": 1.1, "expo": "1e3", "version_string": "4.1.0"}}'
  json_masked: '{"version": 4, "values": {"phone": "0123456789", "leading_zero": 7,
    "underscored": 1000, "quoted_int": "42", "plain_int": 42, "negative": -17, "hex":
