- id: nested_sequences
  yaml: "version: 4\nroutes:\n  - name: first\n    destinations: [youtube, x]\n  \
    \  weights: [1, 2.5, 3]\n  - name: second\n    destinations:\n      - bluesky\n"
  outcome: ok
  json_raw: '{"version": 4, "routes": [{"name": "first", "destinations": ["youtube",
    "x"], "weights": [1, 2.5, 3]}, {"name": "second", "destinations": ["bluesky"]}]}'
  json_masked: '{"version": 4, "routes": [{"name": "first", "destinations": ["youtube",
    "x"], "weights": [1, 2.5, 3]}, {"name": "second", "destinations": ["bluesky"]}]}'
- id: deep_nesting
  yaml: "version: 4\na:\n  b:\n    c:\n      d:\n        e: 1\n        f: [1, [2,\
    \ [3]]]\n"
  outcome: ok
  json_raw: '{"version": 4, "a": {"b": {"c": {"d": {"e": 1, "f": [1, [2, [3]]]}}}}}'
  json_masked: '{"version": 4, "a": {"b": {"c": {"d": {"e": 1, "f": [1, [2, [3]]]}}}}}'
- id: anchors_and_aliases
  yaml: "version: 4\ndefaults: &d\n  enabled: true\n  retries: 3\nservice_a:\n  <<:\
    \ *d\n  name: a\nservice_b:\n  <<: *d\n  name: b\n"
  outcome: ok
  json_raw: '{"version": 4, "defaults": {"enabled": true, "retries": 3}, "service_a":
    {"enabled": true, "retries": 3, "name": "a"}, "service_b": {"enabled": true, "retries":
    3, "name": "b"}}'
