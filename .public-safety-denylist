# Personal-identifier deny list for scripts/scan_public_safety.py.
#
# D-2 of docs/DIRECTION.md: zero personal data in the codebase. This file is
# loaded by the scanner by default (tree, artifact and history modes) and is
# unioned with XPST_PUBLIC_SAFETY_DENYLIST, so the gate enforces it in CI with
# no environment plumbing.
#
# Format: one banned token per line, matched case-insensitively on word
# boundaries in the publishable tree and in built artifacts, and reported
# (never gating) in git history. '#' starts a comment; blank lines are
# ignored. Findings never echo the matched value.
#
# This file is the list of banned names, not personal data: it is the one
# tracked file the scan exempts from its own deny list.

# The maintainer's public handles and account names.
tysais
tys.ais
tys_ais
tysn
tysn.dev
tysn_dev

# The maintainer's personal identifiers (name, earlier account names) are
# NEVER committed to this repository. They are supplied locally through the
# XPST_PUBLIC_SAFETY_DENYLIST environment variable, which the scanner unions
# with this file (see scripts/scan_public_safety.py).

# Account identifiers from earlier personal accounts are likewise supplied
# only through the environment variable above, never committed.

# Product-level identifiers. D-2 permits these because they name the project,
# not the person; matching ignores any banned token that occurs inside one of
# them. Everything outside these strings is still reported.
allow: github.com/tysais
allow: tysais/xpst
allow: tysais@users.noreply.github.com
allow: tysais.github.io
allow: com.tysais.xpst

# The GitHub account name quoted in backticks, as documentation writes it
# (the PyPI trusted-publisher form needs the exact spelling; see docs/PYPI.md).
allow: `tysais`

# The GitHub handle as release notes write it ("by @TysAIs"): the public
# account that owns the project, not the person. Same reasoning as the
# product identifiers above.
allow: @tysais
